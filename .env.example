# ---------- Application ----------
PROJECT_NAME="FastAPI Boilerplate"
VERSION="1.0.0"
DESCRIPTION="A clean, production-ready FastAPI boilerplate."
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000

# ---------- Security ----------
# Generate a strong key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=please-change-me-to-a-random-64-character-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# ---------- CORS ----------
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Database ----------
# SQLite (default for local dev)
DATABASE_URL=sqlite:///./app.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/app

# ---------- First superuser (auto-created on startup) ----------
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=ChangeMe123!

# ---------- Email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=no-reply@example.com
EMAILS_FROM_NAME="FastAPI Boilerplate"
